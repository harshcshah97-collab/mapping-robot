<?xml version="1.0"?>
<robot name="my_robot">

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz = "0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.25 0.20"/> </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/> </joint>

  <link name="base_laser"/>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_laser"/>
    <origin xyz="0 0 0.115" rpy="0 0 0"/> 
  </joint>

  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.05 0 0.10" rpy="3.14159 0 0"/>
  </joint>

  <!-- Approximate OAK-D Lite mount. Measure and update this origin before
       using camera depth as a navigation costmap source. -->
  <link name="oakd_link"/>

  <joint name="oakd_joint" type="fixed">
    <parent link="base_link"/>
    <child link="oakd_link"/>
    <origin xyz="0.07 0 0.14" rpy="0 0 0"/>
  </joint>

  <link name="oakd_rgb_camera_optical_frame"/>

  <joint name="oakd_rgb_optical_joint" type="fixed">
    <parent link="oakd_link"/>
    <child link="oakd_rgb_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="ultrasonic_link">
    <visual>
      <geometry>
        <box size="0.04 0.02 0.02"/> </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.02 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="ultrasonic_joint" type="fixed">
    <parent link="base_link"/>  <child link="ultrasonic_link"/>
    <origin xyz="0.06 0 0.1" rpy="0 0 0"/>
  </joint>

  <link name="ir_left_link" />
  
  <joint name="ir_left_joint" type="fixed">
      <parent link="base_link"/>
      <child link="ir_left_link"/>
      <origin xyz="0.05 0.115 0.09" rpy="0 0 0.785"/> 
  </joint>

  <link name="ir_right_link" />
  
  <joint name="ir_right_joint" type="fixed">
      <parent link="base_link"/>
      <child link="ir_right_link"/>
      <origin xyz="0.05 -0.115 0.09" rpy="0 0 -0.785"/>
  </joint>

</robot>
